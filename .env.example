# Ket noi Supabase qua transaction pooler (cong 6543), bat buoc sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Khoa API Gemini dung chung cho chat va embedding
GEMINI_API_KEY=your-gemini-api-key

# Chuoi base64 cua "publicKey:secretKey" lay tu trang Settings cua Langfuse
# Vi du tao tren Linux/macOS: echo -n "pk-lf-xxx:sk-lf-xxx" | base64
LANGFUSE_BASIC_AUTH=
LANGFUSE_HOST=http://localhost:3000
