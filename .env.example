# Ket noi Supabase qua Session pooler (cong 5432), bat buoc sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Khoa API Gemini dung chung cho chat va embedding
GEMINI_API_KEY=your-gemini-api-key
